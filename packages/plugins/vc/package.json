{
    "name": "@learncard/vc-plugin",
    "version": "1.5.11",
    "description": "",
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/vc-plugin.esm.js",
    "exports": {
        ".": {
            "development": "./src/index.ts",
            "import": {
                "types": "./dist/index.d.ts",
                "default": "./dist/vc-plugin.esm.js"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        }
    },
    "files": [
        "dist",
        "src"
    ],
    "scripts": {
        "build": "node ./scripts/build.mjs && shx cp ./scripts/mixedEntypoint.js ./dist/index.cjs && tsc --p tsconfig.json && shx cp ./dist/index.d.ts ./dist/index.d.cts",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage"
    },
    "author": "Learning Economy Foundation (www.learningeconomy.io)",
    "license": "MIT",
    "homepage": "https://github.com/learningeconomy/LearnCard/tree/main/packages/plugins/vc/README.md",
    "repository": {
        "type": "git",
        "url": "https://github.com/learningeconomy/LearnCard"
    },
    "bugs": {
        "url": "https://github.com/learningeconomy/LearnCard/issues"
    },
    "devDependencies": {
        "@types/node": "^17.0.31",
        "aqu": "0.4.3",
        "esbuild": "^0.27.1",
        "esbuild-plugin-copy": "^1.3.0",
        "shx": "^0.3.4"
    },
    "types": "./dist/index.d.ts",
    "dependencies": {
        "@learncard/core": "workspace:*",
        "@learncard/didkit-plugin": "workspace:^",
        "@learncard/types": "workspace:*",
        "multiformats": "^11.0.1"
    },
    "sideEffects": false
}
