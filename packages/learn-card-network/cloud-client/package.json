{
    "name": "@learncard/learn-cloud-client",
    "version": "1.7.0",
    "description": "",
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/learn-cloud-client.esm.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "development": "./src/index.ts",
            "import": {
                "types": "./dist/index.d.ts",
                "default": "./dist/learn-cloud-client.esm.js"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        }
    },
    "files": [
        "dist",
        "src"
    ],
    "scripts": {
        "build": "node ./scripts/build.mjs && shx cp ./scripts/mixedEntypoint.js ./dist/index.cjs && tsc --p tsconfig.json && node ./scripts/bundle-types.mjs",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage"
    },
    "keywords": [],
    "author": "Learning Economy Foundation (www.learningeconomy.io)",
    "license": "MIT",
    "devDependencies": {
        "@learncard/learn-cloud-service": "workspace:*",
        "@learncard/types": "workspace:*",
        "dts-bundle-generator": "^6.10.0",
        "esbuild": "^0.28.2",
        "rollup": "^4.50.0",
        "rollup-plugin-dts": "^6.2.0",
        "vitest": "4.1.11"
    },
    "dependencies": {
        "@trpc/client": "11.8.0",
        "@trpc/server": "11.8.0"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/learningeconomy/LearnCard"
    },
    "homepage": "https://github.com/learningeconomy/LearnCard/tree/main/packages/learn-card-network/cloud-client/README.md",
