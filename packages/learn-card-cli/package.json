{
    "name": "@learncard/cli",
    "version": "4.0.3",
    "description": "Command Line Interface for LearnCard",
    "main": "dist/index.js",
    "bin": {
        "learncard": "dist/index.js",
        "cli": "dist/index.js"
    },
    "files": [
        "dist",
        "examples",
        "README.md",
        "CHANGELOG.md"
    ],
    "engines": {
        "node": ">=20"
    },
    "scripts": {
        "start": "bun scripts/embed-snippets.ts && bun --conditions=development src/index.tsx",
        "start:built": "bun run build && node dist/index.js",
        "dev": "bun run start",
        "build": "bun scripts/embed-snippets.ts && bun scripts/build.ts",
        "build:binary": "bun run build && bun scripts/build-binary.ts",
        "test": "bun scripts/embed-snippets.ts && vitest run",
        "test:watch": "bun scripts/embed-snippets.ts && vitest",
        "test:coverage": "bun scripts/embed-snippets.ts && vitest run --coverage"
    },
    "author": "Learning Economy Foundation (www.learningeconomy.io)",
    "license": "MIT",
    "dependencies": {
        "@learncard/core": "workspace:*",
        "@learncard/didkit-plugin": "workspace:^",
        "@learncard/holder-continuity": "workspace:*",
        "@learncard/init": "workspace:^",
        "@learncard/lca-api-plugin": "workspace:*",
        "@learncard/learn-cloud-plugin": "workspace:*",
        "@learncard/ler-rs-plugin": "workspace:*",
        "@learncard/linked-claims-plugin": "workspace:*",
        "@learncard/network-brain-client": "workspace:*",
        "@learncard/open-badge-v2-plugin": "workspace:*",
        "@learncard/render-method-plugin": "workspace:*",
        "@learncard/types": "workspace:*",
        "clipboardy": "^4.0.0",
        "commander": "^9.3.0",
        "gradient-string": "^2.0.1",
        "pretty-repl": "^3.1.1",
        "yaml": "^2.9.1",
        "zod": "^4.1.13"
    },
    "devDependencies": {
        "@learncard/credential-library": "workspace:*",
        "@types/cors": "^2.8.12",
        "@types/node": "^18.0.0",
        "esbuild": "^0.27.1",
        "nodemon": "^2.0.16",
        "ts-node": "^10.8.1",
        "vitest": "4.1.11"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/learningeconomy/LearnCard"
    },
    "homepage": "https://github.com/learningeconomy/LearnCard/tree/main/packages/learn-card-cli/README.md",
    "bugs": {
        "url": "https://github.com/learningeconomy/LearnCard/issues"
    }
}
