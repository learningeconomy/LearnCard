{
    "name": "@learncard/service-config",
    "version": "0.1.1",
    "private": true,
    "description": "Shared runtime configuration helpers for LearnCard services (runtime secrets, per-stage config, Lambda bootstrap)",
    "main": "src/index.ts",
    "types": "src/index.ts",
    "exports": {
        ".": "./src/index.ts",
        "./function-env.cjs": "./function-env.cjs"
    },
    "files": [
        "src",
        "function-env.cjs"
    ],
    "scripts": {
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "typecheck": "tsc --noEmit -p tsconfig.json"
    },
    "author": "Learning Economy Foundation (www.learningeconomy.io)",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/learningeconomy/LearnCard"
    },
    "homepage": "https://github.com/learningeconomy/LearnCard/tree/main/packages/service-config/README.md",
    "bugs": {
        "url": "https://github.com/learningeconomy/LearnCard/issues"
    },
    "dependencies": {
        "@aws-sdk/client-secrets-manager": "^3.1139.0"
    },
    "devDependencies": {
        "@types/node": "^18.7.19",
        "vitest": "4.1.11"
    },
    "sideEffects": false
}
