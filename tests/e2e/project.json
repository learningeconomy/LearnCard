{
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "name": "e2e",
    "sourceRoot": "tests/e2e/tests",
    "projectType": "application",
    "root": "tests/e2e",
    "tags": [],
    "implicitDependencies": ["init", "helpers", "lca-api-plugin", "nx-run-command"],
    "namedInputs": {
        "tests": ["{projectRoot}/tests/**/*"]
    },
    "targets": {
        "test:e2e": {
            "executor": "nx:run-script",
            "dependsOn": ["^build"],
            "options": {
                "script": "test:e2e"
            }
        },
        "test:run": {
            "executor": "nx:run-script",
            "dependsOn": ["^build"],
            "options": {
                "script": "test:run"
            }
        },
        "build": {
            "executor": "nx:noop",
            "dependsOn": ["^build"]
        }
    }
}
