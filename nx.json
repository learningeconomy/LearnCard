{
    "npmScope": "learncard",
    "cli": {
        "packageManager": "bun"
    },
    "tasksRunnerOptions": {
        "default": {
            "runner": "nx/tasks-runners/default",
            "options": {
                "cacheDirectory": ".nx-cache",
                "cacheableOperations": ["build", "test"]
            }
        }
    },
    "targetDefaults": {
        "start": {
            "dependsOn": ["^build"]
        },
        "dev": {
            "dependsOn": ["^build"]
        },
        "build": {
            "dependsOn": ["^build"],
            "outputs": ["{projectRoot}/dist"]
        },
        "test": {
            "dependsOn": ["^build"],
            "outputs": ["{projectRoot}/coverage"],
            "inputs": ["default", "^default", "ciTestConfig"]
        },
        "test:coverage": {
            "dependsOn": ["^build"],
            "outputs": ["{projectRoot}/coverage"],
            "inputs": ["default", "^default", "ciTestConfig"]
        }
    },
    "defaultBase": "main",
    "namedInputs": {
        "ciTestConfig": [
            "{workspaceRoot}/vitest.shared.ts",
            "{workspaceRoot}/scripts/ci-test-retries/**/*",
            "{projectRoot}/vitest.config.*",
            "{projectRoot}/vite.config.*",
            "{projectRoot}/package.json",
            {
                "env": "LC_CI_TEST_RETRY"
            }
        ]
    }
}
