{
    "npmScope": "learncard",
    "cli": {
        "packageManager": "bun"
    },
    "cacheDirectory": ".nx-cache",
    "targetDefaults": {
        "start": {
            "dependsOn": ["^build"]
        },
        "dev": {
            "dependsOn": ["^build"]
        },
        "build": {
            "cache": false,
            "dependsOn": ["^build"],
            "outputs": ["{projectRoot}/dist"]
        },
        "test": {
            "cache": false,
            "dependsOn": ["^build"],
            "outputs": ["{projectRoot}/coverage"],
            "inputs": ["default", "^default", "ciTestConfig"]
        },
        "test:coverage": {
            "cache": false,
            "dependsOn": ["^build"],
            "outputs": ["{projectRoot}/coverage"],
            "inputs": ["default", "^default", "ciTestConfig"]
        }
    },
    "defaultBase": "main",
    "namedInputs": {
        "sdkBuild": [
            "{projectRoot}/src/**/*",
            "{projectRoot}/scripts/**/*",
            "{projectRoot}/*",
            "{workspaceRoot}/package.json",
            "{workspaceRoot}/bun.lock",
            "{workspaceRoot}/bunfig.toml",
            "{workspaceRoot}/tsconfig*.json",
            "{workspaceRoot}/nx.json",
            "{workspaceRoot}/.nvmrc",
            {
                "runtime": "node -p \"JSON.stringify([process.version, process.platform, process.arch])\""
            },
            { "runtime": "bun --version" },
            { "env": "NODE_ENV" },
            { "env": "NODE_OPTIONS" }
        ],
        "ciTestConfig": [
            "{workspaceRoot}/vitest.shared.ts",
            "{workspaceRoot}/scripts/ci-test-retries/**/*",
            "{projectRoot}/vitest.config.*",
            "{projectRoot}/vite.config.*",
            "{projectRoot}/package.json",
            {
                "env": "LC_CI_TEST_RETRY"
            }
        ]
    }
}
