# syntax=docker/dockerfile:1.7

# Stage 1: collect only the files `bun install` reads (workspace manifests,
# lockfile, patches). The *output* of this stage only changes when dependencies
# change, so the expensive `bun install` layer below stays cached across
# ordinary code commits instead of being invalidated by every `COPY . .`.
# A read-only bind mount avoids caching a full-source intermediate image layer.
FROM oven/bun:1.4.2 AS manifests

WORKDIR /src
RUN --mount=type=bind,target=/src \
    mkdir -p /manifests \
    && find . -name package.json -not -path '*/node_modules/*' -exec cp --parents {} /manifests \; \
    && cp bun.lock bunfig.toml /manifests/ \
    && cp -R patches /manifests/patches

FROM oven/bun:1.4.2 AS dependencies

ENV SKIP_DIDKIT_NAPI=1

WORKDIR /app

COPY --from=manifests /manifests ./

RUN --mount=type=cache,target=/root/.bun/install/cache \
    bun install

# Keep the installed dependency layers intact. Only the executable needs the
# older runtime: Bun 1.4.2 bypasses the localhost host-gateway mapping used for
# cross-service did:web resolution. Copying /app into a fresh base duplicates the
# entire dependency tree and makes image export expensive.
FROM oven/bun:1.3.14 AS compatible-runtime

# Hosted services need production dependencies, not frontend/build/test tooling.
# Keep manifests for every workspace so the unchanged lockfile can be validated.
FROM oven/bun:1.4.2 AS backend-dependencies

ENV SKIP_DIDKIT_NAPI=1
WORKDIR /app
COPY --from=manifests /manifests ./
RUN --mount=type=cache,target=/root/.bun/install/cache \
    bun install --frozen-lockfile --production \
        --filter '!./' \
        --filter '@learncard/network-brain-service...' \
        --filter '@learncard/learn-cloud-service...' \
        --filter '@learncard/lca-api-service...'

FROM oven/bun:1.4.2 AS backend-source
WORKDIR /src
RUN --mount=type=bind,target=/src \
    bun scripts/e2e-hosted/prepare-backend-source.mjs /backend-source

# Inherit only the filtered dependency layers; do not delete files from the full
# monorepo image (its earlier layers would still be included in the export).
FROM backend-dependencies AS backend
COPY --from=compatible-runtime /usr/local/bin/bun /usr/local/bin/bun
RUN test "$(bun --version)" = "1.3.14" \
    && test "$(bunx --version)" = "1.3.14"
COPY --from=backend-source /backend-source ./

# Retain the full source image as the default for existing local build commands.
FROM dependencies AS source

COPY --from=compatible-runtime /usr/local/bin/bun /usr/local/bin/bun
RUN test "$(bun --version)" = "1.3.14" \
    && test "$(bunx --version)" = "1.3.14"

COPY . .
