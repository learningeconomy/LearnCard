{
    "name": "escrow-ledger-monitor",
    "projectType": "application",
    "sourceRoot": "services/escrow-ledger-monitor/src",
    "targets": {
        "build": {
            "executor": "nx:run-commands",
            "options": {
                "cwd": "services/escrow-ledger-monitor",
                "command": "cargo build --release --locked"
            }
        },
        "test": {
            "executor": "nx:run-commands",
            "options": { "cwd": "services/escrow-ledger-monitor", "command": "cargo test --locked" }
        },
        "lint": {
            "executor": "nx:run-commands",
            "options": {
                "cwd": "services/escrow-ledger-monitor",
                "command": "cargo clippy --all-targets --locked -- -D warnings"
            }
        },
        "fmt-check": {
            "executor": "nx:run-commands",
            "options": { "cwd": "services/escrow-ledger-monitor", "command": "cargo fmt --check" }
        }
    }
}
