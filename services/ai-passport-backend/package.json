{
    "name": "ai-passport-backend",
    "license": "MIT",
    "module": "src/index.ts",
    "type": "module",
    "private": true,
    "scripts": {
        "build": "bun build src/index.ts src/mcp-server/index.ts src/workers/index.ts --outdir dist --target bun --conditions development && bun run scripts/package-privacy-assets.ts && bun run build:admin",
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "build:docker": "docker build -f Dockerfile ../..",
        "start": "bun --conditions=development src/index.ts",
        "start:mcp": "bun --conditions=development src/mcp-server/index.ts",
        "start:workers": "bun --conditions=development src/workers/index.ts",
        "dev": "bun --conditions=development --watch src/index.ts",
        "dev:mcp": "bun --conditions=development --watch src/mcp-server/index.ts",
        "dev:workers": "bun --conditions=development --watch src/workers/index.ts",
        "dev:tunnel": "./src/mcp-server/start-tunnels.sh",
        "_comment_test": "Run tests individually to avoid Bun's global mock.module() bleeding between test files. Not named `test` so `nx affected -t test` skips it; it needs Mongo, Redis, Qdrant and the privacy runtime (see .github/workflows/ai-passport.yml).",
        "test:unit": "bun run build:admin && bun run scripts/test.ts",
        "check:env": "bun run scripts/check-env.ts",
        "test:cost-controls": "bun run scripts/test.ts --cost-controls",
        "test:privacy-runtime": "bun test privacy/runtime.test.ts",
        "docker:up": "docker-compose up -d",
        "docker:down": "docker-compose down",
        "docker:logs": "docker-compose logs -f",
        "dev:with-db": "docker-compose up -d && bun --conditions=development --watch src/index.ts",
        "benchmark:session-start": "bun run scripts/benchmark-session-start.ts",
        "benchmark:bedrock": "bun run scripts/benchmark-bedrock.ts",
        "migrate:privacy": "bun run scripts/migrate-privacy-data.ts",
        "build:admin": "bun scripts/build-admin.mjs"
    },
    "devDependencies": {
        "@trpc/client": "11.8.0",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/express": "^4.17.21",
        "vite": "^6.1.0",
        "@tailwindcss/vite": "^4.0.6",
        "tailwindcss": "^4.0.6",
        "@types/react": "^19.0.8",
        "@types/react-dom": "^19.0.3",
        "react-test-renderer": "19.2.4",
        "@types/react-test-renderer": "^19.0.0"
    },
    "dependencies": {
        "@aws/bedrock-token-generator": "1.1.0",
        "@aws-sdk/client-bedrock": "3.1138.0",
        "@aws-sdk/client-bedrock-runtime": "3.1138.0",
        "@aws-sdk/credential-providers": "3.1138.0",
        "@googleapis/youtube": "^31.0.0",
        "@learncard/didkit-plugin": "workspace:*",
        "@learncard/init": "workspace:*",
        "@learncard/types": "workspace:*",
        "@modelcontextprotocol/sdk": "^1.20.2",
        "@qdrant/js-client-rest": "1.17.0",
        "@opentelemetry/sdk-trace-base": "2.8.0",
        "@sentry/node": "10.63.0",
        "@smithy/core": "3.35.0",
        "@types/uuid": "^10.0.0",
        "axios": "^1.12.2",
        "bullmq": "^5.46.1",
        "express": "^4.21.1",
        "ioredis": "^5.6.0",
        "ioredis-mock": "^8.13.0",
        "jsonwebtoken": "^9.0.2",
        "mongodb": "^6.17.0",
        "openai": "^6.47.0",
        "uuid": "^11.1.0",
        "zod": "4.3.6",
        "@launchdarkly/node-server-sdk": "9.14.1",
        "react": "19.2.4",
        "react-dom": "19.2.4"
    }
}
