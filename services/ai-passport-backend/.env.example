# --- AI providers (checked at startup; bad values stop the process with a list of fixes) ---
# LLM_PROVIDER: bedrock (default; the only value allowed on Fly) | openai (local dev without AWS access)
LLM_PROVIDER=bedrock
# EMBEDDINGS_PROVIDER picks the default embedding generation. Unset follows LLM_PROVIDER.
#   bedrock (default): Nova 2 1024 (nova1024v1) reads and writes, same AWS credentials as generation.
#   openai (local dev opt-in): legacy text-embedding-3-small 1536 (openai1536); needs OPENAI_API_KEY.
# EMBEDDINGS_READ_GENERATION / EMBEDDINGS_WRITE_GENERATION / EMBEDDINGS_DUAL_WRITE and
# BEDROCK_EMBEDDINGS_ENABLED still override it (migration and rollback controls).
# Vectors from different generations live in separate Qdrant collections. Seed local data with the one you query.
EMBEDDINGS_PROVIDER=bedrock
# Only needed for LLM_PROVIDER=openai, openai1536 reads or writes (EMBEDDINGS_PROVIDER=openai,
# EMBEDDINGS_*_GENERATION=openai1536) or EMBEDDINGS_DUAL_WRITE=true.
# OPENAI_API_KEY=

# --- Bedrock (generation when LLM_PROVIDER=bedrock; the privacy guardrail on every AI call) ---
# Local dev: the team's shared Bedrock API key, no MFA step and nothing to create in AWS. Copy
# AWS_BEARER_TOKEN_BEDROCK from Infisical (secret-management project):
# https://app.infisical.com/organizations/20ceb16d-56de-4cc7-a303-59c9271a3ffa/projects/secret-management/d9fdd58f-d499-4644-8cb4-55faf414af68/overview
# It is sent as Authorization: Bearer for generation and the guardrail. Keep the line commented out until
# you've pasted the key in (other AWS tools treat a blank value as an empty token). Startup rejects it on Fly.
# Never commit the key.
# AWS_BEARER_TOKEN_BEDROCK=
# Without a key, off Fly, @aws/bedrock-token-generator mints short-term tokens from the default SDK
# credential chain (AWS_PROFILE, ~/.aws, CI OIDC). On Fly, AWS_ROLE_ARN in fly.toml enables the
# automatically refreshed AWS_WEB_IDENTITY_TOKEN_FILE (no hardcoded role ARN in application TypeScript).
# Bedrock region: only us-east-1 is approved (endpoint, inference profiles and guardrail).
AWS_REGION=us-east-1
# Only the reviewed US Runtime endpoint is accepted. Never set OPENAI_BASE_URL.
BEDROCK_BASE_URL=https://bedrock-runtime.us-east-1.amazonaws.com/openai/v1
# Required for any AI call, including LLM_PROVIDER=openai, unless the local-dev bypass below is on.
# Guardrail version must be an approved immutable positive numeric version, not DRAFT. Never commit credentials.
BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=
# !!! YOU ARE BYPASSING THE PRIVACY GUARDRAIL. LOCAL DEV ONLY. NEVER USE IN PROD. !!!
# Skips Bedrock ApplyGuardrail so LLM_PROVIDER=openai works with zero AWS access. Unmasked free-text PII
# (anything the local pseudonymizer doesn't catch) then goes straight to the model provider. Only the exact
# value "true" enables it; any other value except "false" fails startup. Startup and every guardrail call
# refuse it unless this is local dev (NODE_ENV unset/development, localhost DOMAIN and CORS_ORIGINS, and no
# Fly, Netlify CONTEXT, CI or other hosted-runtime variables). Use synthetic data only.
# DANGEROUSLY_BYPASS_PRIVACY_GUARDRAIL=true
LCA_BACKEND_SEED=111
# SEED is retained as a local fallback when LCA_BACKEND_SEED is unavailable.
SEED=111
REDIS_PREFIX=default
QDRANT_PREFIX=default
JWT_SECRET=
LCA_URL=https://learncard.app
DOMAIN=http://localhost:3001
BIND_HOST=127.0.0.1
# Required independent 32-byte base64 privacy key. Generate and store in your
# secret manager; do not reuse JWT_SECRET or commit a populated value.
AI_PRIVACY_KEY=
# Container images bundle local extraction/OCR only; no neural model or PyTorch.
AI_PRIVACY_PYTHON=/opt/ai-privacy/bin/python
AI_PRIVACY_ASSET_DIR=/opt/ai-privacy/assets
AI_PRIVACY_OCR_LANGUAGES=eng+spa+fra+deu+por+ita+ara+rus+hin+chi_sim+chi_tra+jpn+kor
# Raw debug is allowed only in development/test with exclusively loopback origins.
AI_LOCAL_DEBUG_LOGGING=false
LEARNCARD_NETWORK_URL=https://network.learncard.com/trpc
LEARNCARD_CLOUD_URL=https://cloud.learncard.com/trpc

CORS_ORIGINS=http://localhost:3000,http://localhost:4321
AUTH_CHALLENGE_TTL_SECONDS=300
AUTH_SESSION_HANDOFF_TTL_SECONDS=60
AUTH_WEBSOCKET_TICKET_TTL_SECONDS=45
AUTH_SESSION_TTL_SECONDS=604800
# AI Model configuration (model ids for both LLM providers)
# gpt-6-luna maps to Bedrock profile us.openai.gpt-6-luna, gpt-6.1-sol to us.openai.gpt-6.1-sol;
# with LLM_PROVIDER=openai the same ids go to OpenAI without the us.openai. prefix.
CHAT_MODEL=gpt-6.1-sol
PLANNING_MODEL=gpt-6.1-sol
FORMATTING_MODEL=gpt-6-luna-none
TITLE_MODEL=gpt-6-luna-none
# Luna's model-card enum is none/low/medium/high/xhigh/max (default medium).
# Generation uses SDK Responses reasoning: { effort }, unchanged from role aliases.
# Sol 6.1: low/medium(default)/high/xhigh/max; none/minimal reject.
# Luna: none/low/medium(default)/high/xhigh/max; minimal rejects.
# All 19 default shapes serialize locally; live provider/account acceptance is pending.
# Non-strict client tools preserve optional fields; original Zod validates final output.
# Invalid output rejects without retry/fallback. Embedding model: EMBEDDING_MODEL (default text-embedding-3-small).
CREDENTIAL_INGESTION_STARTUP_WAIT_MS=2000

OPEN_SYLLABUS_API_KEY=OPEN_SYLLABUS_API_KEY

CAREER_ONE_STOP_CONFIG=CAREER_ONE_STOP_CONFIG
# Sentry Error Tracking
SENTRY_DSN=

# YouTube Data API v3
# Get your API key from: https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=