{
    "$schema": "../../../node_modules/nx/schemas/project-schema.json",
    "name": "network-brain-service",
    "sourceRoot": "services/learn-card-network/brain-service/src",
    "projectType": "application",
    "root": "services/learn-card-network/brain-service",
    "tags": [],
    "implicitDependencies": [
        "core",
        "crypto-plugin",
        "did-web-plugin",
        "didkey-plugin",
        "didkit-plugin",
        "expiration-plugin",
        "learn-card-plugin",
        "vc-plugin",
        "vc-templates-plugin",
        "helpers",
        "types",
        "nx-run-command"
    ],
    "namedInputs": {
        "source": ["{projectRoot}/src/**/*"],
        "tests": ["{projectRoot}/test/**/*"],
        "dist": ["{projectRoot}/dist/**/*"]
    },
    "targets": {
        "serverless-deploy": {
            "executor": "nx:run-script",
            "inputs": ["source"],
            "dependsOn": ["^build"],
            "options": {
                "script": "serverless-deploy"
            }
        },
        "build": {
            "executor": "nx:run-script",
            "inputs": ["source"],
            "options": {
                "script": "build"
            }
        },
        "build:docker": {
            "executor": "nx:run-script",
            "inputs": ["source"],
            "dependsOn": ["^build"],
            "options": {
                "script": "build:docker"
            }
        },
        "start:docker": {
            "executor": "nx:run-script",
            "inputs": ["source"],
            "options": {
                "script": "start:docker"
            }
        },
        "start": {
            "executor": "nx:run-script",
            "inputs": ["source"],
            "dependsOn": ["^build"],
            "options": {
                "script": "start"
            }
        },
        "start-p-4000": {
            "executor": "nx:run-script",
            "inputs": ["source"],
            "dependsOn": ["^build"],
            "options": {
                "script": "start-p-4000"
            }
        },
        "test": {
            "executor": "nx:run-script",
            "inputs": ["source", "tests"],
            "options": {
                "script": "test"
            }
        },
        "typecheck": {
            "executor": "nx:run-script",
            "dependsOn": ["^build"],
            "options": {
                "script": "typecheck"
            }
        },
        "test:watch": {
            "executor": "nx:run-script",
            "options": {
                "script": "test:watch"
            }
        },
        "test:integration": {
            "executor": "nx:run-script",
            "inputs": ["source", "tests"],
            "options": {
                "script": "test:integration"
            }
        }
    }
}
