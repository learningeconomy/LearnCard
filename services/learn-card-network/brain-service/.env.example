# Brain service: copy to .env. These values are disposable local examples, not deploy secrets.
# Public settings live in config/config.json and config/config.<stage>.json.
# Precedence: schema defaults < base < stage < Lambda runtime bundle < non-empty real env.
# CONFIG_STAGE=dev or production opts local/Docker/offline into a checked-in stage.
# Without CONFIG_STAGE, keep using local env and schema defaults as before.
# Lambda selects LAMBDA_STAGE; its bundle is brain-service/<stage>/runtime-secrets.
# RUNTIME_SECRETS_ID is ignored outside Lambda. Keep GitHub fallbacks for rollback.
CONFIG_STAGE=
# Dev curator: getLearnCard('a'.repeat(64)).id.did(), as in seed-dev-wallets.ts.
# Replace this disposable identity outside local development; unset means deny all.
WORKLOAD_CURATOR_DIDS=did:key:z6Mkv1o2GEgtXjFdEMfLtupcKhGRydM8V7VHzii7Uh4aHoqH
WORKLOAD_LOCAL_COMPOSE_ENABLED=false
# Shared secret for lcn-workload-agent (x-workload-agent-token); required when local compose is enabled.
WORKLOAD_AGENT_TOKEN=
RUNTIME_SECRETS_ID=

# Required credentials. Replace every local example before connecting to shared services.
SEED=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=this-is-the-password

# Optional integration credentials; all are bundle/fallback-only in Lambda.
POSTMARK_API_KEY=
MESSAGEBIRD_AUTH_TOKEN=
SENTRY_DSN=
POSTHOG_API_KEY=
SKILL_EMBEDDING_GOOGLE_API_KEY=
SKILLS_PROVIDER_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
SMART_RESUME_CLIENT_ID=
SMART_RESUME_ACCESS_KEY=
SMART_RESUME_CONTRACT_URI=
APP_STORE_ADMIN_PROFILE_IDS=
LOGIN_PROVIDER_DID=
NOTIFICATIONS_SERVICE_WEBHOOK_URL=
# Both checked-in stages enable credential refresh. Use independent, stable private secrets.
CREDENTIAL_REFRESH_DIGEST_SECRET=local-only-replace-before-deploy-refresh-digest-secret
SHARE_LINK_REQUEST_HASH_SECRET=local-only-replace-before-deploy-share-link-request-secret

# Local infrastructure. Explicit env overrides the selected stage; unset overrides you don't want.
NODE_ENV=development
IS_OFFLINE=true
PORT=3000
REDIS_HOST=
REDIS_PORT=
AWS_REGION=
NOTIFICATIONS_QUEUE_URL=
INBOX_QUEUE_URL=
INBOX_DEAD_LETTER_QUEUE_URL=
INBOX_QUEUE_ENDPOINT=
NOTIFICATIONS_QUEUE_POLL_URL=
# Non-offline self-hosters must supply DOMAIN_NAME or select a registered CONFIG_STAGE.
# For local DID resolution, an explicit override can be DOMAIN_NAME=localhost%3A4000.
DOMAIN_NAME=
CLIENT_APP_DOMAIN_NAME=
CLIENT_APP_PORT=3000
SKILL_FRAMEWORK_ADMIN_PROFILE_IDS=
SKILL_FRAMEWORK_SEED_OWNER_PROFILE_ID=
TRUSTED_BRAIN_SERVICES=
TRUSTED_ISSUERS_WHITELIST=
OIDC_TRUSTED_ISSUERS=
OIDC_EXPECTED_AUDIENCE=
NOTIFICATIONS_SERVICE_PORT=5100
BRAIN_SERVICE_REGISTRY_URL=
DCC_KNOWN_REGISTRIES_URL=
OPENSALT_BASE_URL=
OPENSALT_STAGING_BASE_URL=

SKILLS_PROVIDER=
SKILLS_PROVIDER_BASE_URL=
SKILL_EMBEDDING_GOOGLE_MODEL=
SKILL_EMBEDDING_CACHE_TTL_SECONDS=
SKILL_EMBEDDING_BATCH_SIZE=
SKILL_EMBEDDING_BACKFILL_BATCH_SIZE=
SKILL_EMBEDDING_BACKFILL_LOCK_TTL_SECONDS=
SKILL_EMBEDDING_BACKFILL_PAGE_SIZE=
SKILL_SEMANTIC_SEARCH_RATE_LIMIT_PER_MIN=

# App-store inline templates: LCA API signing authority that apps' credentials are signed through.
SIGNING_AUTHORITY_ENDPOINT=http://localhost:5100/api

POSTMARK_BRAND_NAME=
POSTMARK_FROM_EMAIL=
TWILIO_FROM_NUMBER=
MESSAGEBIRD_ORIGINATOR=

POSTHOG_HOST=https://us.i.posthog.com
GIT_SHA=
SENTRY_ENV=development

BITSTRING_STATUS_LIST_SIZE=
IS_CI=false
IS_E2E_TEST=false
ENABLE_BENCH_ROUTES=false
ENABLE_SEND_CREDENTIAL_TELEMETRY=false
LC_PERF_LOG=false
NEO4J_SKIP_INDICES=false
SKILL_EMBEDDING_BACKFILL_ON_STARTUP=false
SKILL_FRAMEWORKS_DEBUG=false
SKIP_DIDKIT_NAPI=false
SKIP_SKILL_FRAMEWORK_SEED=false
TRACE_CONSOLE=true
TRACE_JSON=false
BITSTRING_STATUS_LIST_ALLOW_SMALL=false
AUTHORIZED_SERVICE_DIDS=
INSTALL_INTENT_RECONCILER_SCHEDULER_DISABLED=false

# Profile the local console signs in as; receives the OWNER grant from seed:education-os.
# Read it off the console Session card after signing in.
DEV_OPERATOR_PROFILE_ID=
INSTALL_INTENT_RECONCILER_ALLOW_LOCAL_COORDINATION=
INSTALL_INTENT_RECONCILER_DISABLED=false
INSTALL_INTENT_RECONCILER_DISABLED_ECOSYSTEM_IDS=
INSTALL_INTENT_RECONCILER_MAX_RETRIES=
INSTALL_INTENT_RECONCILER_BACKOFF_MS=
INSTALL_INTENT_RECONCILER_STUCK_THRESHOLD_MS=
INSTALL_INTENT_RECONCILER_ALERT_MAX_STUCK_INTENTS=
INSTALL_INTENT_RECONCILER_ALERT_MAX_DEGRADED_INTENTS=
INSTALL_INTENT_RECONCILER_ALERT_MAX_FAILED_INTENTS=
INSTALL_INTENT_RECONCILER_TENANT_CONCURRENCY=
INSTALL_INTENT_RECONCILER_INTERVAL_MS=
INSTALL_INTENT_RECONCILER_HEALTH_INTERVAL_MS=

# Enable only after reviewing expired Universal Inbox audit history.
INBOX_DELETE_EXPIRED_RECORDS=false

# Managed credential refresh (LC-2117/LC-2135/LC-2136).
# Set to 'true' to mount the authenticated GET /refresh/{refreshId} endpoints.
# When enabled, CREDENTIAL_REFRESH_DIGEST_SECRET is required (validated at startup).
CREDENTIAL_REFRESH_ENABLED=false
# Hours during which repeat refresh notifications collapse into one unread record.
CREDENTIAL_REFRESH_NOTIFICATION_WINDOW_HOURS=24

# LC-2187 service wiring and automatic recovery/cleanup maintenance.
# Supply an explicit namespace, trusted LearnCloud origin and audience;
# malformed values fail closed without graph/remote/signing work.
SHARE_LINK_MAINTENANCE_NAMESPACE=
SHARE_LINK_MAINTENANCE_ORIGIN=
SHARE_LINK_MAINTENANCE_AUDIENCE=
SHARE_LINK_MAINTENANCE_ALLOW_INSECURE_LOOPBACK=false
SHARE_LINK_MAINTENANCE_CLAIMANT=brain-share-link-maintenance
SHARE_LINK_MAINTENANCE_RECOVERY_LIMIT=25
SHARE_LINK_MAINTENANCE_CLEANUP_LIMIT=25
SHARE_LINK_MAINTENANCE_LEASE_MS=120000
SHARE_LINK_MAINTENANCE_CLAIM_MS=300000
SHARE_LINK_MAINTENANCE_BUDGET_MS=60000
SHARE_LINK_MAINTENANCE_INTERVAL_MS=300000
SHARE_LINK_MAINTENANCE_REQUEST_TIMEOUT_MS=10000
SHARE_LINK_MAINTENANCE_FINALIZE_RESERVE_MS=5000
SHARE_LINK_MAINTENANCE_GRAPH_TIMEOUT_MS=15000

# Owner/public APIs and maintenance are available once the service wiring above
# is valid. UI rollout is controlled only by LaunchDarkly share-links-enabled.
# Optional owner namespace override must match SHARE_LINK_MAINTENANCE_NAMESPACE.
SHARE_LINK_OWNER_API_NAMESPACE=
# Independent 32+ byte secret, identical on all Brain instances and stable across
# deployments. Required when the owner API is enabled; test runs use a test-only key.
# Production unknown-age policy defaults to 30 days and does not count views.

# Optional sample-persona seeder (not Lambda runtime configuration).
MONGO_URI=mongodb://localhost:27017/?replicaSet=rs0
MONGO_DB_NAME=lca-api
DEMO_PERSONA_SIGNING_AUTHORITY_ENDPOINT=http://localhost:5100/api
DEMO_PERSONA_SA_SEED=
# SENTRY_AUTH_TOKEN / SENTRY_ORG / SENTRY_PROJECT belong only in the build environment.
