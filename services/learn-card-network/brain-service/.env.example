SEED=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
NEO4J_URI=neo4j+s://example.com
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=asdfasdfasdfasdfasdfasdfasdfasdfasdf

# LC-1644 perf bench (admin-only). Optional — if unset, the bench still runs
# but emits no PostHog events.
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
GIT_SHA=

# Set to 'true' to mount /bench/* perf routes (dev/staging only)
ENABLE_BENCH_ROUTES=

# Managed credential refresh (LC-2117/LC-2135/LC-2136).
# Set to 'true' to mount the authenticated GET /refresh/{refreshId} endpoints.
# When enabled, CREDENTIAL_REFRESH_DIGEST_SECRET is required (validated at startup).
CREDENTIAL_REFRESH_ENABLED=
CREDENTIAL_REFRESH_DIGEST_SECRET=
