# LCA API environment
# Copy to .env. Validation runs before database/client initialization.
#
# Config resolves lowest→highest: schema defaults < config/config.json <
# config/config.<stage>.json < runtime AWS secrets bundle (Lambda only) < real env.
# Empty values are unset. The config/config*.json stage files are PUBLIC BY DESIGN:
# put only non-secret config there. Secrets (credentials, AUTHORIZED_DIDS allowlist,
# internal endpoints, signing keys) stay in the runtime bundle or this local .env.
# Stage = LAMBDA_STAGE on Lambda, else CONFIG_STAGE; unknown stage uses config.json only.
# Self-hosting: copy config/config.example.json to a stage file, or just use this .env.
# Keep the entries you need locally even once a stage uses the runtime bundle.

NODE_ENV=development
# Lambda sets LAMBDA_STAGE; elsewhere CONFIG_STAGE selects the config.<stage>.json file.
LAMBDA_STAGE=
CONFIG_STAGE=
PORT=3000
SEED=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
# Local development keeps plaintext behavior by default. To opt in, enable encrypted
# writes and set a key from `openssl rand -hex 32`; retain it for the database lifetime.
SA_SEED_LOCAL_KEK=
SA_SEED_KMS_KEY_ARN=
SA_SEED_ENCRYPT_WRITES=false
SA_SEED_ALLOW_LEGACY_READ=true
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=learncard
DOMAIN_NAME=
AUTHORIZED_DIDS=

LEARN_CLOUD_URL=
NETWORK_BRAIN_SERVICE_URL=
GOOGLE_APPLICATION_CREDENTIAL=
# Lambda deploys may instead set RUNTIME_SECRETS_ID=lca-api/<stage>/runtime-secrets.
# This secret bundle holds secrets only; non-secret per-stage config lives in the
# checked-in config/config.<stage>.json files, not here and not in the bundle.
# SecretString: flat env-name -> string JSON (including the Firebase JSON as a string).
# Loaded before validation; non-empty explicit env wins. Leave unset for local/Docker/CI.
# Keep all GitHub runtime secret fallbacks until each stage has a complete bundle.
RUNTIME_SECRETS_ID=
OPENAI_API_KEY=
METABASE_SECRET_KEY=
SCOUTS_SSO_CLIENT_SECRET=

# Comma-separated exact Keycloak issuers (e.g. http://localhost:8081/realms/learncard).
KEYCLOAK_ISSUERS=
# Comma-separated allowed client IDs (e.g. learncard-app); matches aud or azp.
KEYCLOAK_AUDIENCES=
# Optional issuer=url pairs for internal JWKS endpoints, separated by commas.
# Example: http://localhost:8081/realms/learncard=http://keycloak:8080/realms/learncard/protocol/openid-connect/certs
KEYCLOAK_JWKS_URL_OVERRIDES=

# Minimal self-issued OIDC provider (AD-2). Keycloak trusts lca-api as an
# upstream Identity Provider: the app proves ownership in-app, exchanges the
# proof for a single-use login ticket, and Keycloak redeems it via the
# authorization-code flow (/oidc/authorize -> /oidc/token).
# OIDC_ISSUER: REQUIRED issuer identifier baked into discovery/tokens (no
#   default; unset = 503).
# OIDC_SIGNING_KEY_JWK: local/Docker/CI override, JSON RSA private JWK with d, kid
#   and alg RS256, SEPARATE from SEED. Takes precedence over the secret id.
# OIDC_SIGNING_KEY_SECRET_ID: deployed Lambda secret name or ARN, convention
#   lca-api/<stage>/oidc-signing-jwk in the Lambda account/region. SecretString
#   must be a plain string containing the same JWK JSON (no wrapper).
#   Fetched and cached per process; failed loads retry and readiness returns 503.
#   Redeploy after rotation. Neither source set: prod = 503; dev/CI = ephemeral key.
# OIDC_CLIENT_ID / OIDC_CLIENT_SECRET: credentials of the confidential Keycloak
#   broker client that calls /oidc/token (default id 'keycloak-broker').
#   OIDC_CLIENT_SECRET stays a GitHub-environment secret on the OIDC function and
#   is NEVER placed in the runtime bundle; its signing key uses a separate AWS secret.
# OIDC_REDIRECT_URIS: optional redirect-uri allowlist override (defaults to
#   each KEYCLOAK_ISSUERS entry plus /broker/lca-api/endpoint). Exact match only;
#   when neither list is set every redirect is rejected.
OIDC_ISSUER=
OIDC_SIGNING_KEY_JWK=
OIDC_SIGNING_KEY_SECRET_ID=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URIS=

# Native Google/Apple social login: comma-separated allowed client ids.
# Issuers and JWKS are fixed to the respective provider.
GOOGLE_OAUTH_CLIENT_IDS=
APPLE_OAUTH_CLIENT_IDS=

# Configure both Postmark credentials or leave both empty for log delivery.
POSTMARK_SERVER_TOKEN=
POSTMARK_FROM_EMAIL=
POSTMARK_BRAND_NAME=LearnCard
POSTMARK_LOGIN_CODE_TEMPLATE_ALIAS=
POSTMARK_ENDORSEMENT_REQUEST_TEMPLATE_ALIAS=
POSTMARK_RECOVERY_EMAIL_CODE_TEMPLATE_ALIAS=
POSTMARK_RECOVERY_KEY_TEMPLATE_ALIAS=

ESCROW_RELAY_URL=
ESCROW_RELAY_AUTH_TOKEN=

# Automatic (escrow) recovery. Unset disables all /keys/escrow routes.
# Local dev: set ESCROW_ENCLAVE_MODE=software with the disposable fixture below, which
# pairs with the public key in apps/learn-card-app/environments/learncard/config.local.json.
# The fixture is NOT a secret and must never be used outside local development.
# See docs/how-to-guides/deploy-infrastructure/sss-key-management-config.md.
ESCROW_ENCLAVE_MODE=
ESCROW_ENCLAVE_ACTIVE_KEY_ID=
ESCROW_ENCLAVE_SOFTWARE_PRIVATE_KEYS_JSON=
# ESCROW_ENCLAVE_MODE=software
# ESCROW_ENCLAVE_ACTIVE_KEY_ID=local-dev
# ESCROW_ENCLAVE_SOFTWARE_PRIVATE_KEYS_JSON={"local-dev":"MIGHAgEAMBMGByqGSM49AgEGCCqGSM49AwEHBG0wawIBAQQgv1vJWrZWg8ydq4ibGe6/IqEw/BEIcgI+Y3c6hnoeF2ehRANCAAQ08rGhw2reTThF/ecfafLzjphjmqvySHJZwqKfqSn8YPK/1GMWODPWounlJ2MZb/iS/D69K0k9durGsGjaSb0I"}
# Waiting period in ms (default 7 days). Local QA only: shorten to one minute.
ESCROW_HOLD_DURATION_MS=
ESCROW_HOLD_RESTART_MIN_AGE_MS=
# ESCROW_HOLD_DURATION_MS=60000

# ESCROW_ENCLAVE_MODE=remote: HTTP client to the enclave-host parent (P3.3).
# URL must be https:// unless NODE_ENV=test or the host is localhost. Token
# is a bearer credential, minimum 32 characters. Timeout defaults to 10000ms
# (max 30000ms). Missing/invalid config fails escrow closed at request time
# rather than crashing the whole service at boot.
ESCROW_ENCLAVE_REMOTE_URL=
ESCROW_ENCLAVE_REMOTE_TOKEN=
ESCROW_ENCLAVE_REMOTE_TIMEOUT_MS=

# Emergency stop: true blocks every escrow release (read per request, no restart needed).
# Deploy toggle, forwarded even in runtime-secrets bundle mode.
ESCROW_RELEASE_KILL_SWITCH=

ANDROID_PUSH_ICON=
REDIS_HOST=
REDIS_PORT=
NSO_DASHBOARD_ID=
GLOBAL_DASHBOARD_ID=
TROOP_DASHBOARD_ID=

SENTRY_DSN=
SENTRY_ENV=development
IS_OFFLINE=true
IS_CI=false
IS_E2E_TEST=false
SKIP_DIDKIT_NAPI=false
CI=false
