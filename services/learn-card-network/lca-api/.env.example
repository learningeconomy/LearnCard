# LCA API environment
# Copy to .env. Validation runs before database/client initialization.

NODE_ENV=development
PORT=3000
SEED=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=learncard
DOMAIN_NAME=
AUTHORIZED_DIDS=

LEARN_CLOUD_URL=
NETWORK_BRAIN_SERVICE_URL=
GOOGLE_APPLICATION_CREDENTIAL=
OPENAI_API_KEY=
METABASE_SECRET_KEY=
SCOUTS_SSO_CLIENT_SECRET=

# Comma-separated exact Keycloak issuers (e.g. http://localhost:8081/realms/learncard).
KEYCLOAK_ISSUERS=
# Comma-separated allowed client IDs (e.g. learncard-app); matches aud or azp.
KEYCLOAK_AUDIENCES=
# Optional issuer=url pairs for internal JWKS endpoints, separated by commas.
# Example: http://localhost:8081/realms/learncard=http://keycloak:8080/realms/learncard/protocol/openid-connect/certs
KEYCLOAK_JWKS_URL_OVERRIDES=

# Configure both Postmark credentials or leave both empty for log delivery.
POSTMARK_SERVER_TOKEN=
POSTMARK_FROM_EMAIL=
POSTMARK_BRAND_NAME=LearnCard
POSTMARK_LOGIN_CODE_TEMPLATE_ALIAS=
POSTMARK_ENDORSEMENT_REQUEST_TEMPLATE_ALIAS=
POSTMARK_RECOVERY_EMAIL_CODE_TEMPLATE_ALIAS=
POSTMARK_RECOVERY_KEY_TEMPLATE_ALIAS=

ANDROID_PUSH_ICON=
REDIS_HOST=
REDIS_PORT=
NSO_DASHBOARD_ID=
GLOBAL_DASHBOARD_ID=
TROOP_DASHBOARD_ID=

SENTRY_DSN=
SENTRY_ENV=development
IS_OFFLINE=false
IS_CI=false
IS_E2E_TEST=false
SKIP_DIDKIT_NAPI=false
CI=false
