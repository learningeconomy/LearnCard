# LearnCloud service environment
# Copy to .env. Validation runs before database/client initialization.

NODE_ENV=development
PORT=3000
LEARN_CLOUD_SEED=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
LEARN_CLOUD_MONGO_URI=mongodb://localhost:27017
LEARN_CLOUD_MONGO_DB_NAME=learncloud
DOMAIN_NAME=
SERVER_URL=http://localhost:4100
XAPI_ENDPOINT=

# Configure both RSA values or leave both empty to generate an ephemeral pair.
RSA_PRIVATE_KEY=
RSA_PUBLIC_KEY=

REDIS_HOST=
REDIS_PORT=
SENTRY_DSN=
SENTRY_ENV=development
IS_OFFLINE=false
SKIP_DIDKIT_NAPI=false
CI=false

# LC-2187 service-only share-content routes start with valid service configuration.
# All four values are required and REDIS_HOST/REDIS_PORT must point at the real
# replay store. Real values are provisioned per environment, never committed.
# LearnCloud's own service DID that service tokens must address.
SHARE_CONTENT_AUDIENCE=
# Comma-separated allowlisted Brain service DIDs.
SHARE_CONTENT_SERVICE_DIDS=
# Comma-separated exact JWS `kid` verification methods (DID URL with fragment).
SHARE_CONTENT_VERIFICATION_METHODS=
# JSON object mapping each service DID to the namespaces it may use, e.g.
# {"did:web:brain.example":["learncard"]}
SHARE_CONTENT_NAMESPACE_BINDINGS=
