# LearnCloud: copy to .env. Values below are disposable local examples, not deploy secrets.
# Public configuration lives in config/config.json and config/config.<stage>.json.
# Precedence: schema defaults < base < stage < Lambda runtime bundle < non-empty real env.
# CONFIG_STAGE=dev or production opts local/Docker/offline into checked-in stage settings.
# Without CONFIG_STAGE, keep using local env and schema defaults as before.
# Lambda selects LAMBDA_STAGE; the bundle is learn-cloud-service/<stage>/runtime-secrets.
# Leave RUNTIME_SECRETS_ID unset locally. Keep GitHub fallbacks for rollback.
CONFIG_STAGE=
RUNTIME_SECRETS_ID=

# Required credentials: replace every example before connecting to shared services.
LEARN_CLOUD_SEED=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
LEARN_CLOUD_MONGO_URI=mongodb://localhost:27017
LEARN_CLOUD_MONGO_DB_NAME=learncloud

# Optional runtime credentials, including the private xAPI endpoint.
XAPI_ENDPOINT=
XAPI_USERNAME=
XAPI_PASSWORD=
JWT_SIGNING_KEY=
SENTRY_DSN=
# Configure both RSA values or leave both empty to generate an ephemeral pair.
RSA_PRIVATE_KEY=
RSA_PUBLIC_KEY=

# Local infrastructure. Explicit env wins over a selected stage.
NODE_ENV=development
IS_OFFLINE=true
PORT=3000
REDIS_HOST=
REDIS_PORT=
# Local URL override, if needed: SERVER_URL=http://localhost:4100.
# SENTRY_ENV and SHARE_CONTENT_* trust settings come from the selected stage.
# Self-hosters can register config/config.example.json as their own stage or use explicit env.
# SENTRY_AUTH_TOKEN / SENTRY_ORG / SENTRY_PROJECT belong only in the build environment.
