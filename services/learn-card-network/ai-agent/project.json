{
    "$schema": "../../../node_modules/nx/schemas/project-schema.json",
    "name": "ai-agent-service",
    "sourceRoot": "services/learn-card-network/ai-agent/src",
    "projectType": "application",
    "root": "services/learn-card-network/ai-agent",
    "tags": [],
    "namedInputs": {
        "source": ["{projectRoot}/src/**/*", "{projectRoot}/public/**/*"],
        "tests": ["{projectRoot}/test/**/*"],
        "runtimeDidAuth": [
            "{projectRoot}/scripts/test-runtime-did-auth.mjs",
            "{projectRoot}/scripts/runtime-did-auth-smoke.ts",
            "{projectRoot}/Dockerfile",
            "{workspaceRoot}/packages/plugins/didkit/src/didkit/**/*",
            "{workspaceRoot}/packages/plugins/didkit/package.json"
        ],
        "dist": ["{projectRoot}/dist/**/*"]
    },
    "targets": {
        "build": {
            "executor": "nx:run-script",
            "inputs": ["source"],
            "dependsOn": [],
            "options": {
                "script": "build"
            }
        },
        "start": {
            "executor": "nx:run-script",
            "inputs": ["source"],
            "dependsOn": [],
            "options": {
                "script": "start"
            }
        },
        "start:docker": {
            "executor": "nx:run-script",
            "inputs": ["source"],
            "dependsOn": [],
            "options": {
                "script": "start:docker"
            }
        },
        "test": {
            "executor": "nx:run-script",
            "inputs": ["source", "tests"],
            "dependsOn": ["test:runtime-did-auth"],
            "options": {
                "script": "test"
            }
        },
        "test:runtime-did-auth": {
            "executor": "nx:run-script",
            "cache": false,
            "inputs": ["runtimeDidAuth", "^default"],
            "dependsOn": [],
            "options": {
                "script": "test:runtime-did-auth"
            }
        }
    }
}
