{
    "name": "@learncard/ai-agent-service",
    "version": "0.0.6",
    "private": true,
    "description": "Production LearnCard AI agent service with DID-authenticated wallet, memory, and assistant APIs.",
    "main": "dist/index.js",
    "engines": {
        "node": ">=24.18 <25",
        "bun": ">=1.4.2"
    },
    "scripts": {
        "build": "rm -rf dist && bun build src/index.ts --target=bun --conditions=development --outfile=dist/index.js --external='@learncard/didkit-plugin/dist/didkit_wasm_bg.wasm'",
        "dev": "bun --conditions=development --watch src/index.ts",
        "dev:prod": "NODE_ENV=production bun --conditions=development --watch src/index.ts",
        "autonomy:once": "bun --conditions=development src/autonomy/once.ts",
        "autonomy:dev": "bun --conditions=development src/autonomy/dev.ts",
        "trigger:dev": "trigger dev",
        "trigger:deploy": "trigger deploy",
        "start": "bun --conditions=development src/index.ts",
        "start:docker": "bun --conditions=development src/index.ts",
        "smoke:staging": "bun --conditions=development scripts/smoke.ts",
        "smoke:feed-wasm": "bun --conditions=development scripts/assistant-feed-wasm-regression.ts",
        "smoke:sentry": "bun --conditions=development scripts/sentry-telemetry-smoke.ts",
        "test:runtime-did-auth": "node scripts/test-runtime-did-auth.mjs",
        "test": "bunx vitest"
    },
    "keywords": [],
    "author": "Learning Economy Foundation (www.learningeconomy.io)",
    "license": "MIT",
    "dependencies": {
        "@aws-sdk/client-cloudwatch": "^3.1120.0",
        "@launchdarkly/node-server-sdk": "^9.13.1",
        "@learncard/didkit-plugin": "workspace:*",
        "@learncard/didkit-plugin-node": "workspace:*",
        "@learncard/init": "workspace:*",
        "@learncard/network-brain-client": "workspace:*",
        "@sentry/node": "7.61.0",
        "@trigger.dev/sdk": "4.5.7",
        "cors": "^2.8.5",
        "croner": "^10.0.1",
        "dotenv": "^16.0.3",
        "express": "^4.18.2",
        "express-rate-limit": "^8.0.1",
        "mongodb": "^6.2.0",
        "openai": "^4.55.7",
        "zod": "4.1.13"
    },
    "devDependencies": {
        "@trigger.dev/build": "4.5.7",
        "@types/cors": "^2.8.13",
        "@types/express": "^4.17.15",
        "@types/node": "^24.0.0",
        "trigger.dev": "4.5.7",
        "vitest": "^4.1.11"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/learningeconomy/LearnCard"
    },
    "homepage": "https://github.com/learningeconomy/LearnCard/tree/main/services/learn-card-network/ai-agent",
    "bugs": {
        "url": "https://github.com/learningeconomy/LearnCard/issues"
    }
}
