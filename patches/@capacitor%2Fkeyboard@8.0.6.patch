+- (void)resizeForKeyboardNotification:(NSNotification *)notification height:(int)height fallbackDelay:(NSTimeInterval)delay
+{
+  if (self.keyboardResizes != ResizeNative) {
+    [self setKeyboardHeight:height delay:delay];
+    return;
+  }
+
+  if (self.paddingBottom == height && self.resizeDisplayLink == nil) return;
+  self.paddingBottom = height;
+  [self.resizeDisplayLink invalidate];
+  self.resizeDisplayLink = nil;
+  [self.resizeAnimationView removeFromSuperview];
+  self.resizeAnimationView = nil;
+  NSUInteger generation = ++self.resizeAnimationGeneration;
+
+  CGRect currentFrame = self.webView.frame;
+  CGRect windowBounds = [self currentKeyWindow].bounds;
+  CGRect targetFrame = CGRectMake(currentFrame.origin.x, currentFrame.origin.y,
+      windowBounds.size.width - currentFrame.origin.x,
+      windowBounds.size.height - currentFrame.origin.y - height);
+
+  // Expand before dismissal exposes the area below the old viewport. Expanding
+  // WKWebView incrementally lets its asynchronous paint trail the keyboard,
+  // revealing its empty backing surface for several frames.
+  if (height == 0) {
+    self.webView.frame = targetFrame;
+    return;
+  }
+
+  // WKWebView lays out at an animation's destination size immediately. Animate
+  // an invisible UIKit guide instead and resize the real viewport on each frame,
+  // so the web content keeps filling the area above the moving keyboard.
+  UIView *guide = [[UIView alloc] initWithFrame:currentFrame];
+  guide.userInteractionEnabled = NO;
+  guide.hidden = YES;
+  [self.webView.superview addSubview:guide];
+  self.resizeAnimationView = guide;
+  self.resizeDisplayLink = [CADisplayLink displayLinkWithTarget:self selector:@selector(updateAnimatedKeyboardFrame:)];
+  [self.resizeDisplayLink addToRunLoop:NSRunLoop.mainRunLoop forMode:NSRunLoopCommonModes];
+
+  NSTimeInterval duration = [notification.userInfo[UIKeyboardAnimationDurationUserInfoKey] doubleValue];
+  NSUInteger curve = [notification.userInfo[UIKeyboardAnimationCurveUserInfoKey] unsignedIntegerValue];
+  UIViewAnimationOptions options = (curve << 16) | UIViewAnimationOptionBeginFromCurrentState | UIViewAnimationOptionAllowUserInteraction;
+  [UIView animateWithDuration:duration delay:0 options:options animations:^{
+    guide.frame = targetFrame;
+  } completion:^(BOOL finished) {
+    if (generation != self.resizeAnimationGeneration) return;
+    [self.resizeDisplayLink invalidate];
+    self.resizeDisplayLink = nil;
+    [guide removeFromSuperview];
+    self.resizeAnimationView = nil;
+    self.webView.frame = targetFrame;
+  }];
+}
+
+- (void)updateAnimatedKeyboardFrame:(CADisplayLink *)displayLink
+{
+  CALayer *presentation = self.resizeAnimationView.layer.presentationLayer;
+  if (presentation != nil) self.webView.frame = presentation.frame;
+}
