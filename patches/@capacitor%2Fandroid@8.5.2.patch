     private String insetsHandling = INSETS_HANDLING_CSS;
     private boolean hasViewportCover = false;
+    private boolean keyboardAnimationPending;
+    private int keyboardAnimationTargetBottom;
+    private final Runnable keyboardAnimationRecovery = this::endKeyboardAnimation;
+
+    // The keyboard plugin owns the IME animation callback. Cooperate with that
+    // callback rather than resizing to the destination during the earlier
+    // onApplyWindowInsets pass, which exposes WebView's empty backing surface.
+    public void beginKeyboardAnimation(long durationMillis) {
+        View view = getActivity().getWindow().getDecorView();
+        view.removeCallbacks(keyboardAnimationRecovery);
+        keyboardAnimationPending = true;
+        keyboardAnimationTargetBottom = view.getPaddingBottom();
+        // Android 11 can cancel after onPrepare without any later callback.
+        // Release the deferral even when onStart/onEnd never arrive.
+        view.postDelayed(keyboardAnimationRecovery, durationMillis >= 0 ? durationMillis + 250 : 1250);
+    }
+
+    public int getKeyboardAnimationTargetBottom() {
+        return keyboardAnimationTargetBottom;
+    }
+
+    public void endKeyboardAnimation() {
+        View view = getActivity().getWindow().getDecorView();
+        view.removeCallbacks(keyboardAnimationRecovery);
+        if (!keyboardAnimationPending) return;
+        keyboardAnimationPending = false;
+        ViewCompat.requestApplyInsets(view);
+    }
+
+    @Override
+    protected void handleOnDestroy() {
+        getActivity().getWindow().getDecorView().removeCallbacks(keyboardAnimationRecovery);
+        keyboardAnimationPending = false;
+    }
+
+    private int keyboardBottomPadding(View view, int bottom) {
+        keyboardAnimationTargetBottom = bottom;
+        return keyboardAnimationPending ? view.getPaddingBottom() : bottom;
+    }
 
