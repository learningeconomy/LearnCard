# ScoutPass build environment
#
# Runtime APIs, auth, branding, observability, and feature flags belong in
# environments/scoutpass/config.json plus the selected stage overlay.
# Vite validates the selector and build flags before starting or building.

# Valid selectors:
# development | development-local | staging | staging-scoutpass |
# production | production-scoutpass
VITE_NODE_ENV=development

# Enables the in-app auth/config debug panel outside development.
VITE_ENABLE_AUTH_DEBUG_WIDGET=false

# Explicit source-mode Docker build. Normal production builds leave this false.
VITE_DOCKER_SOURCE=false

# Required public Web3Auth application identifier for ScoutPass.
VITE_WEB3AUTH_CLIENT_ID=
VITE_WEB3AUTH_RPC_TARGET=https://rpc.ankr.com/eth

# Public browser key restricted to ScoutPass origins.
GOOGLE_MAPS_API_KEY=
