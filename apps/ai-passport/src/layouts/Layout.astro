---
import "../styles/global.css";
import ConfirmationModal from "../components/ConfirmationModal.tsx";
import ErrorModal from "../components/ErrorModal.tsx";

import OpenAIIconUrl from "../assets/openai.svg?url";
---

<!doctype html>
<html lang="en" class="h-full">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={OpenAIIconUrl} />
    <title>AI Session • ChatGPT</title>
    <meta
      name="description"
      content="Chat interface powered by ChatGPT"
    />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Sans:ital,wght@0,100..900;1,100..900&family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="h-full bg-gray-900 text-white">
    <slot />
    <ConfirmationModal client:load />
    <ErrorModal client:load />
  </body>
</html>
