{
    "extends": ["astro/tsconfigs/strict", "../../tsconfig.json"],
    "include": [".astro/types.d.ts", "**/*"],
    "exclude": ["dist", "node_modules"],
    "compilerOptions": {
        "jsx": "react-jsx",
        "jsxImportSource": "react",
        // The LearnCard root pins ES2022 and Node/Vitest globals; keep Astro's ESNext
        // target and the Bun globals the app's bun:test suites run under.
        "target": "ESNext",
        "types": ["bun"],
        "paths": {
            "@/*": ["./src/*"],
            "react": ["./node_modules/@types/react"],
            "react/*": ["./node_modules/@types/react/*"],
            "react-dom": ["./node_modules/@types/react-dom"],
            "react-dom/*": ["./node_modules/@types/react-dom/*"]
        }
    }
}
