{
    "extends": ["astro/tsconfigs/strict", "../../tsconfig.json"],
    "include": [".astro/types.d.ts", "**/*"],
    "exclude": ["dist", "node_modules"],
    "compilerOptions": {
        "jsx": "react-jsx",
        "jsxImportSource": "react",
        "baseUrl": ".",
        "paths": {
            "@/*": ["./src/*"],
            "react": ["./node_modules/@types/react"],
            "react/*": ["./node_modules/@types/react/*"],
            "react-dom": ["./node_modules/@types/react-dom"],
            "react-dom/*": ["./node_modules/@types/react-dom/*"]
        }
    }
}
