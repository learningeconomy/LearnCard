# LearnCard App build environment
#
# Runtime APIs, auth, branding, analytics, Sentry, Google Maps, and CORS proxy settings
# belong in the selected TenantConfig under environments/<tenant>/config*.json.
# Vite validates this file before starting or building the app.

# Enables the in-app auth/config debug panel outside development.
VITE_ENABLE_AUTH_DEBUG_WIDGET=false

# Explicit source-mode Docker build. Normal production builds leave this false.
VITE_DOCKER_SOURCE=false

# Optional analytics version override. The package version is used when empty.
VITE_APP_VERSION=

# Build diagnostics.
ANALYZE=false
CHOKIDAR_USEPOLLING=false
CHOKIDAR_INTERVAL=1000
