{
    "compilerOptions": {
        "target": "ES2022",
        "useDefineForClassFields": true,
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "module": "ESNext",
        "skipLibCheck": true,
        "moduleResolution": "bundler",
        "allowImportingTsExtensions": true,
        "resolveJsonModule": true,
        "isolatedModules": true,
        "noEmit": true,
        "jsx": "react-jsx",
        "strict": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noFallthroughCasesInSwitch": true,
        "types": ["vite/client", "node"],
        "baseUrl": ".",
        "paths": {
            "@console-bff/*": ["../../services/learn-card-network/console-bff/src/*"],
            "@brain-service/*": ["../../services/learn-card-network/brain-service/src/*"],
            "@kms": ["../../services/learn-card-network/console-bff/src/kms/index.ts"],
            "@kms/*": ["../../services/learn-card-network/console-bff/src/kms/*"],
            "@did": ["../../services/learn-card-network/console-bff/src/did/index.ts"],
            "@did/*": ["../../services/learn-card-network/console-bff/src/did/*"],
            "@brain": ["../../services/learn-card-network/console-bff/src/brain/index.ts"],
            "@brain/*": ["../../services/learn-card-network/console-bff/src/brain/*"],
            "@session": ["../../services/learn-card-network/console-bff/src/session/index.ts"],
            "@session/*": ["../../services/learn-card-network/console-bff/src/session/*"],
            "@providers": ["../../services/learn-card-network/console-bff/src/providers/index.ts"],
            "@providers/*": ["../../services/learn-card-network/console-bff/src/providers/*"],
            "@identity-provisioning": [
                "../../services/learn-card-network/console-bff/src/identity-provisioning/index.ts"
            ],
            "@identity-provisioning/*": [
                "../../services/learn-card-network/console-bff/src/identity-provisioning/*"
            ]
        }
    },
    "include": ["src"]
}
